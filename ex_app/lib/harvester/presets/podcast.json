{
  "title": "Podcast",
  "source": "feed",
  "description": "A podcast's episodes, newest first, into a folder of its own, tagged with the podcast's name and the year.",
  "parameters": {
    "url": {
      "title": "Feed",
      "default": "",
      "check": "^https?://[^\\s{}$]+$",
      "description": "The podcast's RSS feed. e.g. https://feeds.example.org/show.xml"
    },
    "name": {
      "title": "Name",
      "default": "My podcast",
      "check": "^[^/{}$]{1,80}$",
      "description": "For the folder and the tag."
    },
    "schedule": {
      "title": "Schedule",
      "default": "0 5 * * *",
      "check": "^[0-9*/,-]+( [0-9A-Za-z*/,-]+){4}$",
      "description": "When it runs (cron, UTC): minute, hour, day, month, weekday. The job's form says it in words.",
      "suggestions": [
        {
          "value": "0 5 * * *",
          "label": "Daily 05:00"
        },
        {
          "value": "0 */6 * * *",
          "label": "Every 6 hours"
        },
        {
          "value": "0 * * * *",
          "label": "Hourly"
        },
        {
          "value": "0 5 * * 1",
          "label": "Mondays 05:00"
        },
        {
          "value": "*/15 * * * *",
          "label": "Every 15 minutes"
        },
        {
          "value": "*/30 * * * *",
          "label": "Every 30 minutes"
        }
      ]
    }
  },
  "job": {
    "name": "${name}",
    "source": "feed",
    "target": "/Podcasts/${name}",
    "schedule": "${schedule}",
    "tags": [
      "${name}",
      "{year}",
      "podcast"
    ],
    "options": {
      "url": "${url}",
      "take": "enclosures",
      "path": "{year}/{date} {title}{ext}",
      "file_type": "audio",
      "max_items": 5
    }
  }
}
