{
  "title": "PDFs linked from a page",
  "source": "site",
  "description": "Every PDF a web page links to (minutes, schedules, newsletters), new ones on each run. For a page behind a login or built by JavaScript, record it in the browser instead.",
  "parameters": {
    "url": {
      "title": "Page",
      "default": "",
      "check": "^https?://[^\\s{}$]+$",
      "description": "The page with the links. e.g. https://www.example.org/downloads"
    },
    "name": {
      "title": "Name",
      "default": "Downloads",
      "check": "^[^/{}$]{1,80}$",
      "description": "For the folder and the tag.",
      "suggestions": [
        "Downloads",
        "Minutes",
        "Newsletters",
        "Timetables"
      ]
    },
    "schedule": {
      "title": "Schedule",
      "default": "0 6 * * *",
      "check": "^[0-9*/,-]+( [0-9A-Za-z*/,-]+){4}$",
      "description": "When it runs (cron, UTC): minute, hour, day, month, weekday. The job's form says it in words.",
      "suggestions": [
        {
          "value": "0 6 * * *",
          "label": "Daily 06:00"
        },
        {
          "value": "0 6 * * 1",
          "label": "Mondays 06:00"
        },
        {
          "value": "0 */6 * * *",
          "label": "Every 6 hours"
        },
        {
          "value": "0 6 1 * *",
          "label": "Monthly, the 1st, 06:00"
        },
        {
          "value": "*/15 * * * *",
          "label": "Every 15 minutes"
        },
        {
          "value": "*/30 * * * *",
          "label": "Every 30 minutes"
        }
      ]
    }
  },
  "job": {
    "name": "${name}",
    "source": "site",
    "target": "/Documents/${name}",
    "schedule": "${schedule}",
    "tags": [
      "${name}"
    ],
    "options": {
      "recipe": {
        "start": "${url}",
        "links": {
          "selector": "a[href]",
          "pattern": "\\.pdf(\\?|$)"
        }
      },
      "path": "{filename}",
      "file_type": "pdf",
      "stop_at_seen": 0
    }
  }
}
