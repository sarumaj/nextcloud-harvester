{
  "title": "App releases",
  "source": "releases",
  "description": "The new releases' files of an app on GitHub, GitLab, Codeberg or your own Forgejo or GitLab, e.g. its AppImage or installer.",
  "parameters": {
    "repository": {
      "title": "Repository",
      "default": "",
      "check": "^https?://[^\\s{}$]+$",
      "description": "The repository's page. e.g. https://github.com/owner/name"
    },
    "files": {
      "title": "Files",
      "default": ".*",
      "check": "^[^\\r\\n]{1,200}$",
      "description": "A pattern of the file names, e.g. \\.AppImage$ or x86_64.*\\.tar\\.gz$",
      "suggestions": [
        ".*",
        "\\.AppImage$",
        "x86_64.*\\.tar\\.gz$",
        "(amd64|x86_64).*\\.deb$",
        "\\.(exe|msi)$",
        "\\.dmg$",
        "\\.apk$"
      ]
    },
    "name": {
      "title": "Name",
      "default": "App",
      "check": "^[^/{}$]{1,80}$",
      "description": "For the folder and the tag."
    },
    "schedule": {
      "title": "Schedule",
      "default": "0 6 * * 1",
      "check": "^[0-9*/,-]+( [0-9A-Za-z*/,-]+){4}$",
      "description": "When it runs (cron, UTC): minute, hour, day, month, weekday. The job's form says it in words.",
      "suggestions": [
        {
          "value": "0 6 * * 1",
          "label": "Mondays 06:00"
        },
        {
          "value": "0 6 * * *",
          "label": "Daily 06:00"
        },
        {
          "value": "0 6 1 * *",
          "label": "Monthly, the 1st, 06:00"
        },
        {
          "value": "0 */6 * * *",
          "label": "Every 6 hours"
        },
        {
          "value": "*/15 * * * *",
          "label": "Every 15 minutes"
        },
        {
          "value": "*/30 * * * *",
          "label": "Every 30 minutes"
        }
      ]
    }
  },
  "job": {
    "name": "${name} releases",
    "source": "releases",
    "target": "/Software/${name}",
    "schedule": "${schedule}",
    "tags": [
      "${name}",
      "release"
    ],
    "options": {
      "repository": "${repository}",
      "asset_pattern": "${files}",
      "path": "{tag}/{filename}",
      "max_items": 10
    }
  }
}
