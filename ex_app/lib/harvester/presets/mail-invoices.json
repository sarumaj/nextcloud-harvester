{
  "title": "Invoices from email",
  "source": "mail",
  "description": "The PDF attachments of a sender's messages (invoices, statements, payslips), read-only, into a folder by year. After saving, set the job's account: the mailbox's login.",
  "parameters": {
    "host": {
      "title": "IMAP server",
      "default": "",
      "check": "^[A-Za-z0-9.-]+$",
      "description": "e.g. mail.example.org"
    },
    "folder": {
      "title": "Folder",
      "default": "INBOX",
      "check": "^[^\\r\\n\"]{1,200}$",
      "description": "e.g. INBOX or INBOX/Invoices",
      "suggestions": [
        "INBOX",
        "INBOX/Invoices",
        "INBOX.Invoices",
        "Archive",
        "[Gmail]/All Mail"
      ]
    },
    "sender": {
      "title": "Sender",
      "default": "",
      "check": "^[^\\r\\n]{0,200}$",
      "description": "A part of the sender's address or name, e.g. shop.example (empty: any)."
    },
    "name": {
      "title": "Name",
      "default": "Invoices",
      "check": "^[^/{}$]{1,80}$",
      "description": "For the folder and the tag.",
      "suggestions": [
        "Invoices",
        "Bank statements",
        "Payslips",
        "Receipts"
      ]
    },
    "schedule": {
      "title": "Schedule",
      "default": "0 7 * * *",
      "check": "^[0-9*/,-]+( [0-9A-Za-z*/,-]+){4}$",
      "description": "When it runs (cron, UTC): minute, hour, day, month, weekday. The job's form says it in words.",
      "suggestions": [
        {
          "value": "0 7 * * *",
          "label": "Daily 07:00"
        },
        {
          "value": "0 7 * * 1",
          "label": "Mondays 07:00"
        },
        {
          "value": "0 */6 * * *",
          "label": "Every 6 hours"
        },
        {
          "value": "0 7 1 * *",
          "label": "Monthly, the 1st, 07:00"
        },
        {
          "value": "*/15 * * * *",
          "label": "Every 15 minutes"
        },
        {
          "value": "*/30 * * * *",
          "label": "Every 30 minutes"
        }
      ]
    }
  },
  "job": {
    "name": "${name}",
    "source": "mail",
    "target": "/Documents/${name}",
    "schedule": "${schedule}",
    "tags": [
      "${name}",
      "{year}"
    ],
    "options": {
      "host": "${host}",
      "port": 993,
      "folder": "${folder}",
      "since_days": 365,
      "from_pattern": "${sender}",
      "subject_pattern": "",
      "filename_pattern": "\\.pdf$",
      "path": "{year}/{date} {stem}{ext}",
      "file_type": "pdf",
      "max_items": -1
    }
  }
}
