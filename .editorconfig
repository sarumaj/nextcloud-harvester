# SPDX-License-Identifier: AGPL-3.0-or-later
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,xml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# JavaScript, CSS and shell are indented with tabs, as Nextcloud's coding standard and the page's
# and the recorder's JavaScript have them.
[*.{php,js,vue,css,sh}]
indent_style = tab
indent_size = 4

# start.sh and healthcheck.sh come from Nextcloud's app-skeleton-python, indented with spaces
# (start.sh's here-documents too): kept as they are, to compare with upstream.
[{start.sh,healthcheck.sh,Dockerfile}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
